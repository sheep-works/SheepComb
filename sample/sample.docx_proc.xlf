<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:m="http://www.memsource.com/mxlf/2.0" xmlns:ns1="http://www.w3.org/2005/11/its" xmlns:space="http://www.w3.org/XML/1998/namespace" version="1.2" ns1:version="2.0">
